set -euo pipefail
readonly VERSION="0.1.1" AUTHOR="@mb6ockatf"
case "$1" in
	--help|-h)
		cat <<EOF
getrandomfile
Usage: $0

Arguments:
	none

Output:
	Random file from current directory

Exit:
	0
EOF
		exit 0;
		;;
	--version|-v)
		cat <<-EOF
getrandomfile $VERSION
Copyright (C) 2026 $AUTHOR
This if free software; see the source for copying conditions.  There is NO warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
EOF
		exit 0;
		;;
esac
ls | sort -R | tail -1 | while read file
do
	echo $file
done
