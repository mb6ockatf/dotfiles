set window-title-basename "true"
set selection-clipboard "clipboard"
set notification-error-bg       rgba(247,118,142,1)   # red
set notification-error-fg       rgba(192,202,245,1)   # fg
set notification-warning-bg     rgba(255,158,100,1)   # orange
set notification-warning-fg     rgba(0,0,0,1)         # bg (контраст)
set notification-bg             rgba(0,0,0,1)         # bg
set notification-fg             rgba(192,202,245,1)   # fg
set completion-bg               rgba(0,0,0,1)         # bg
set completion-fg               rgba(122,162,247,1)   # blue
set completion-group-bg         rgba(0,0,0,1)         # bg
set completion-group-fg         rgba(86,95,137,1)     # comment
set completion-highlight-bg     rgba(40,52,87,1)      # selection
set completion-highlight-fg     rgba(192,202,245,1)   # fg
set index-bg                    rgba(0,0,0,1)         # bg
set index-fg                    rgba(192,202,245,1)   # fg
set index-active-bg             rgba(40,52,87,1)      # selection
set index-active-fg             rgba(192,202,245,1)   # fg
set inputbar-bg                 rgba(0,0,0,1)         # bg
set inputbar-fg                 rgba(192,202,245,1)   # fg
set statusbar-bg                rgba(0,0,0,1)         # bg
set statusbar-fg                rgba(192,202,245,1)   # fg
set highlight-color             rgba(224,175,104,0.5) # yellow
set highlight-active-color      rgba(187,154,247,0.5) # purple
set default-bg                  rgba(0,0,0,1)         # bg
set default-fg                  rgba(192,202,245,1)   # fg
set recolor-lightcolor          rgba(0,0,0,1)         # bg
set recolor-darkcolor           rgba(192,202,245,1)   # fg
set recolor true
set render-loading              true
set render-loading-fg           rgba(0,0,0,1)         # bg
set render-loading-bg           rgba(192,202,245,1)   # fg
set adjust-open width
