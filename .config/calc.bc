scale = 20
/* factorial of n*/
define f(n) {
	if (n < 0) {
		return (-1);
		halt
	}
	if (n < 2) return (1);
	return (n * f(n - 1));
}

/* modulo operation. r = result, u = scale_buffer */
define m(a, b) {
	auto r, u
	u = scale
	scale = 0
	r = (a % b)
	scale = u
	return (r)
}

define e(x) {
	auto a, d, e, f, i, m, v, z
	if (x < 0) {
		m = 1
		x = -x
	}
	z = scale;
	scale = 4 + z + .44 * x;
	while (x > 1) {
		f += 1;
		x /= 2;
	}
	v = 1+x
	a = x
	d = 1
	for (i = 2; 1; i++) {
		e = (a *= x) / (d *= i)
		if (e == 0) {
	 		if (f > 0) while (f--)  v = v * v;
			scale = z
			if (m) return (1 / v);
			return (v / 1);
		}
		v += e
	}
}

define g(x) {
	if(x > 0) return (1);
	if (x < 0) return (-1);
}

/* abs */
define b(x) {
	return (g(x) * x);
}
/* max */
define m(x,y) {
	if (x > y) return (x);
	return (y);
}

/* log_b(x) */
define q(x, b){
	return (l(x) / l(b));
}

/* pow */
define p(x, n){
	return (e(n * l(x)));
}

p = 4 * a(1)
e = e(1)
/* phi */
h = (sqrt(5) + 1) / 2

