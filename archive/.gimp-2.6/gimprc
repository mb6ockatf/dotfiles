(num-processors 1)
(tile-cache-size 2G)
(global-brush yes)
(global-pattern yes)
(global-gradient yes)
(global-palette yes)
(global-font yes)
(default-image
        (width 64)
        (height 64)
        (unit pixels)
        (xresolution 64.000000)
        (yresolution 64.000000)
        (resolution-unit inches)
        (image-type rgb)
        (fill-type background-fill))
(undo-levels 0)
(plug-in-history-size 0)
(layer-previews no)
(thumbnail-size none)
(thumbnail-filesize-limit 1K)
(save-document-history no)
(transparency-size large-checks)
(initial-zoom-to-fit no)
(perfect-mouse no)
(cursor-mode crosshair)
(cursor-updating no)
(show-brush-outline no)
(show-paint-tool-cursor no)
(navigation-preview-size tiny)
(zoom-quality low)
(save-session-info no)
(restore-session no)
(save-tool-options no)
(tearoff-menus no)
(save-accels no)
(restore-accels no)
(last-opened-size 8)
(max-new-image-size 16M)
(use-help no)
(show-help-button no)
(help-browser gimp)
(user-manual-online no)

